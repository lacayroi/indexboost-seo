# ============================================================
# IndexBoost SEO — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- SHOPIFY (REQUIRED) ------------------------------------

# Your Shopify app API key (from Partner Dashboard > App setup)
SHOPIFY_API_KEY=your_shopify_api_key_here

# Your Shopify app API secret key (from Partner Dashboard > App setup)
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# The public HTTPS URL where this app is hosted.
# Must NOT be a localhost, admin.shopify.com, or shopify.dev URL.
# Example: https://app.indexboostseo.com
SHOPIFY_APP_URL=https://app.indexboostseo.com

# Comma-separated OAuth scopes. Must match shopify.app.toml [access_scopes].
# Do not change unless you are updating the scope list in the Partner Dashboard.
SCOPES=read_products,write_products,read_content,write_content,read_online_store_navigation,write_online_store_navigation,read_themes,write_themes

# ---- DATABASE (REQUIRED) -----------------------------------

# PostgreSQL connection string.
# Example: postgresql://user:password@localhost:5432/indexboost_seo
DATABASE_URL=postgresql://user:password@localhost:5432/indexboost_seo

# ---- AI SEO (REQUIRED for AI features) --------------------

# Anthropic API key for AI SEO generation (claude-haiku-4-5).
# Get yours at: https://console.anthropic.com/settings/keys
# If not set, AI SEO features will throw on use but other features work normally.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ---- BILLING -----------------------------------------------

# Set to "true" ONLY in development/testing to use Shopify test billing charges.
# MUST be "false" (or unset) in production — validated at startup.
SHOPIFY_BILLING_TEST=false

# ---- RUNTIME -----------------------------------------------

# Node environment. Set to "production" for all production deployments.
# Affects: JSON log format, Prisma query logging, billing test guard.
NODE_ENV=production

# Log level filter. Options: info (default), warn, error.
# Recommended for production: warn (suppresses info logs, keeps warnings + errors).
LOG_LEVEL=warn

# ---- OPTIONAL ----------------------------------------------

# If your store uses a custom domain (e.g., mystore.com instead of mystore.myshopify.com),
# set this to allow the app to recognize it during OAuth.
# SHOP_CUSTOM_DOMAIN=mystore.com

# Separate PostgreSQL URL used by health-check scripts (optional).
# Falls back to DATABASE_URL if not set.
# POSTGRES_DATABASE_URL=postgresql://user:password@localhost:5432/indexboost_seo
